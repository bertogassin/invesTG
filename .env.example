# Optional. Bot dispatcher for group posts and DM notifications — not used for website login.
TELEGRAM_BOT_TOKEN=

# Required for session signing and admin flows.
ADMIN_KEY=change-me
# Optional legacy bot operator ID (notifications/moderation hints). Not used for authentication.
ADMIN_TELEGRAM_ID=0

DATABASE_URL=sqlite:data/votes.db

# Promotion price in euro cents (499 = 4.99 EUR)
PROMOTION_PRICE_MINOR=499

# Stripe (production payments for group promotion)
# Without STRIPE_SECRET_KEY the app uses dev mock payment (instant confirm).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Public URL of this deployment (used for Stripe success/cancel redirects)
PUBLIC_BASE_URL=https://resursmap.de

# One-time owner bootstrap for Admin V2 (creates email owner on first start)
# User id is fixed: 4000000000000000009. Remove or leave empty after first successful start.
OWNER_BOOTSTRAP_EMAIL=
OWNER_BOOTSTRAP_PASSWORD=

# Email auth (Resend)
RESEND_API_KEY=
RESURSMAP_MAIL_FROM=ResursMap <noreply@resursmap.de>
