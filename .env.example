# Optional. When unset, the HTTP server starts in web-only mode without a Telegram dispatcher.
# Build with `cargo build --no-default-features` to omit Teloxide entirely.
TELEGRAM_BOT_TOKEN=

# Required for owner/admin flows and session signing.
ADMIN_KEY=change-me
ADMIN_TELEGRAM_ID=0

DATABASE_URL=sqlite:data/votes.db

# Email auth (Resend)
RESEND_API_KEY=
RESURSMAP_MAIL_FROM=ResursMap <noreply@resursmap.de>
