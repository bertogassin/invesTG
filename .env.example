# Promotion price in euro cents (499 = 4.99 EUR)
PROMOTION_PRICE_MINOR=499

# Email auth (Resend)
RESEND_API_KEY=
RESURSMAP_MAIL_FROM=ResursMap <noreply@resursmap.de>
